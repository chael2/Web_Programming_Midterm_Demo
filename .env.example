MONGODB_URI=mongodb://127.0.0.1:27017/secureguard
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Recommended for any shared deployment: secret for wargame FLAG suffixes and guest-progress
# cookie signing. Generate like AUTH_SECRET. Never commit the real value.
# If empty: a key derived from AUTH_SECRET is used; if both are empty, production
# (`next start`) uses a random per-process key (FLAGs change on restart, single instance
# only) and development (`next dev`) uses readable fixed FLAGs.
WARGAME_FLAG_SECRET=
# E2E API tests (npm run test:e2e) only: URL of a running server, e.g. http://localhost:3000
# SG_BASE_URL=
